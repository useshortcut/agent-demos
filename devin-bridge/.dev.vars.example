# Copy this file to .dev.vars and fill in your values.
# Never commit .dev.vars: it contains secrets.

# From your agent app on Shortcut's Agents page (in the sidebar)
CLIENT_ID=
CLIENT_SECRET=
WEBHOOK_SECRET=

# Where Shortcut will redirect after OAuth; must match what's set on the agent app
REDIRECT_URI=http://localhost:8787/oauth/callback

# From Devin: Settings > Devin API > Service users
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Comma-separated Shortcut workspace ids this bridge serves. Activating from any
# other workspace shows a page with that workspace's id.
ALLOWED_WORKSPACE_IDS=

# Optional: override the Shortcut API host. Defaults to https://api.app.shortcut.com
# SHORTCUT_API_BASE=
# Optional: override the Devin API host (an Enterprise domain). Defaults to https://api.devin.ai
# DEVIN_API_BASE=
