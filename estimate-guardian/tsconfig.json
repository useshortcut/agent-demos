{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // @shortcut/client/webhooks declares a Node.js (req, res) handler overload against node:http; this Worker never uses it.
    "skipLibCheck": true
  },
  "include": ["src"]
}
