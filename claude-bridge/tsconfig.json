{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // The SDK's fetch types reach for miniflare's undici, whose types need Node's.
    "skipLibCheck": true
  },
  "include": ["src"]
}
